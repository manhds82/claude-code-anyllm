{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness.internal/schemas/approval-flow.schema.json",
  "title": "Approval Flow Schema",
  "description": "SSOT for approval gate definitions — who approves what, under which conditions (H5).",
  "type": "object",
  "required": ["schema_version", "flows"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "risk_level", "description", "required_approvers", "approver_roles", "stages"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "description": { "type": "string" },
          "required_approvers": { "type": "integer", "minimum": 1 },
          "approver_roles": { "type": "array", "items": { "type": "string" } },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "required_checks": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "timeout_minutes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
