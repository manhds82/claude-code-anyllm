{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness.internal/schemas/bundle.schema.json",
  "title": "Harness Bundle Manifest",
  "type": "object",
  "required": ["schema_version", "name", "version", "description", "provides"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "maintainer": { "type": "string" },
    "provides": {
      "type": "object",
      "description": "Category -> list of glob patterns (relative to the source harness root).",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
