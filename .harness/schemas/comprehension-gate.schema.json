{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness.internal/schemas/comprehension-gate.schema.json",
  "title": "Comprehension Gate",
  "description": "Config for the human comprehension gate (F6) — the gate no machine can stand in for.",
  "type": "object",
  "required": ["schema_version", "enabled", "enforced_at", "trigger_tiers", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "governs": { "type": "string", "enum": ["assistant_workflow", "product_runtime"] },
    "enabled": { "type": "boolean" },
    "enforced_at": {
      "type": "string",
      "enum": ["not_wired", "standalone", "hook", "workflow_stage"],
      "description": "Where this is actually consulted. Ships as not_wired on purpose; claiming more than reality is the failure C10 exists to catch."
    },
    "enforcement_note": { "type": "string" },
    "why_this_exists": { "type": "string" },
    "when_it_should_be_asked": { "type": "string" },
    "trigger_tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["none", "low", "medium", "high", "critical"] },
      "description": "Risk tiers that trigger the gate. Widening this past high/critical is the documented way this mechanism gets switched off."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "min_chars"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "prompt": { "type": "string", "minLength": 10 },
          "min_chars": { "type": "integer", "minimum": 1, "maximum": 2000 },
          "rule": { "type": "string" },
          "reject_non_answers": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "records_to": { "type": "string" },
    "notes": { "type": "object" }
  },
  "additionalProperties": false
}
