{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness.internal/schemas/release-index.schema.json",
  "title": "Release Index Schema",
  "description": "path -> normalised sha256 for every packed release of a bundle, so harness_fingerprint.py can say which release a checkout really matches. Generated by tools/harness-bundle/build-release-index.py from bundles/<name>/*.bundle.json; never hand-edited.",
  "type": "object",
  "required": ["schema_version", "bundle", "normalisation", "versions", "files"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "bundle": { "type": "string", "minLength": 1 },
    "normalisation": { "type": "string", "description": "How a file is normalised before hashing; the fingerprint must apply the same." },
    "generated_from": { "type": "string" },
    "versions": {
      "type": "array",
      "description": "Packed releases, oldest first. Version ranges in `files` refer to positions in this list.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "content_hash", "file_count"],
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },
          "content_hash": { "type": "string" },
          "file_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "description": "Packed path -> the distinct hashes it has had and the releases carrying each (`a..b` for a run, `a` for one).",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["sha256", "versions"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "versions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^\\d+(\\.\\d+)*(\\.\\.\\d+(\\.\\d+)*)?$" }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
