# LiteLLM virtual environment (created by setup-litellm.ps1)
.venv/
litellm-env/

# NOTE: config/litellm_config.yaml IS committed (a working example). It is
# regenerated on every run, so it may show as modified when you change model/provider.

# Proxy log written by start-claude.sh
litellm-proxy.log
*.log

# Usage log (date/provider/model per run) — personal data, not tracked
logs/

# Secrets / local env files
.env
.env.*
*.key

# OS / editor cruft
Thumbs.db
desktop.ini
.vscode/

# Claude Code local-only settings
.claude/settings.local.json

# Harness Portal ingest key - secret, never commit (C5)
.harness/portal-sync.key

# One-time backup written when a legacy guide block is migrated
*.pre-migration.bak

# Harness ledger append lock - runtime state
.harness/ledger/chain.lock

# Shipped copies the installer leaves beside a file you own or edited - resolve, then delete
*.new

# Harness per-machine state (checkout credential, member_email) - never commit
.harness/local/
