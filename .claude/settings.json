{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "ask": [
      "Agent",
      "Workflow",
      "Skill",
      "CronCreate",
      "CronDelete",
      "TodoWrite"
    ],
    "deny": [
      "Bash: rm -rf",
      "Bash: sudo",
      "Bash: chmod -R",
      "Bash: git reset --hard",
      "Bash: git push --force",
      "Bash: git push --force-with-lease",
      "Bash: del /F /S",
      "PowerShell: Remove-Item -Recurse -Force",
      "PowerShell: Start-Process -Verb RunAs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-session-start.ps1"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/injection-scan.ps1"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-runtime-guard.ps1"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-post-tool-use.ps1"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/agentops-sampler.ps1"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-handoff-check.ps1"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-session-end.ps1"
            ]
          }
        ]
      }
    ]
  }
}
